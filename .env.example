PORT=3000
# Postgres connection string. Vercel: from the Marketplace Postgres integration (Neon). Local: a Postgres server.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_ACCESS_TOKEN=replace-with-workspace-access-token
WEBHOOK_PATH_SECRET=replace-with-long-random-string
# Optional: must match the secret set on the Bitbucket webhook
BITBUCKET_WEBHOOK_SECRET=
# Vercel Cron sends this as a Bearer token to /api/reconcile. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-long-random-string
RECONCILE_INTERVAL_MS=600000

