PORT=3000
# Postgres connection string. Vercel: from the Marketplace Postgres integration (Neon). Local: a Postgres server.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_ACCESS_TOKEN=replace-with-workspace-access-token
WEBHOOK_PATH_SECRET=replace-with-long-random-string
# Password for the dashboard login (any username). Generate with: openssl rand -hex 24
DASHBOARD_PASSWORD=replace-with-long-random-string
# Optional: must match the secret set on the Bitbucket webhook
BITBUCKET_WEBHOOK_SECRET=
# Used only by Vercel Cron, which sends it as a Bearer token to /api/reconcile. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-long-random-string
RECONCILE_INTERVAL_MS=600000
# Optional: a sync stops starting new repos after this many ms and resumes next run. Defaults to 40000 on Vercel, 0 (no limit) elsewhere
RECONCILE_BUDGET_MS=

# Optional: post to this Slack incoming webhook when a branch first turns FAILED
SLACK_WEBHOOK_URL=
# Only branches with a commit in this many days are checked on each sync
RECENT_BRANCH_DAYS=30
